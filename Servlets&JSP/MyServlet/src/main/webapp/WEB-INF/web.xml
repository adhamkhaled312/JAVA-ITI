<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
    version="5.0"
    metadata-complete="true">

    <context-param>
        <param-name>Country</param-name>
        <param-value>Egypt</param-value>
    </context-param>
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.HelloServlet</servlet-class>

        <init-param>
            <param-name>DatabaseAddress</param-name>
            <param-value>163.121.12.25</param-value>
        </init-param>
        <init-param>
            <param-name>userName</param-name>
            <param-value>iTi</param-value>
        </init-param>
        <init-param>
            <param-name>password</param-name>
            <param-value>iTi</param-value>
        </init-param>
    </servlet>
    <servlet>
        <servlet-name>SetterAttributeServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.SetterAttributeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetterAttributeServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.GetterAttributeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SetterCookiesServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.SetterCookiesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetterCookiesServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.GetterCookiesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>WelcomeServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.WelcomeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.SearchServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControllerServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.ControllerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FilteredServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.FilteredServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DownloadServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.DownloadServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>gov.iti.jets.servlet.UploadServlet</servlet-class>
        <multipart-config>
            <location></location>
            <max-file-size>20971520</max-file-size>
        </multipart-config>
    </servlet>



    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/HelloServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SetterAttributeServlet</servlet-name>
        <url-pattern>/SetterAttributeServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetterAttributeServlet</servlet-name>
        <url-pattern>/GetterAttributeServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SetterCookiesServlet</servlet-name>
        <url-pattern>/SetterCookiesServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetterCookiesServlet</servlet-name>
        <url-pattern>/GetterCookiesServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/SearchServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControllerServlet</servlet-name>
        <url-pattern>/ControllerServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FilteredServlet</servlet-name>
        <url-pattern>/FilteredServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DownloadServlet</servlet-name>
        <url-pattern>/DownloadServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/UploadServlet</url-pattern>
    </servlet-mapping>


    <welcome-file-list>
        <welcome-file>file.jsp</welcome-file>
    </welcome-file-list>

    <listener>
        <listener-class>gov.iti.jets.listener.ServletListener</listener-class>
    </listener>
    <listener>
        <listener-class>gov.iti.jets.listener.SessionListener</listener-class>
    </listener>
    
    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>gov.iti.jets.filter.LoggingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>ResponseFilter</filter-name>
        <filter-class>gov.iti.jets.filter.ResponseFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ResponseFilter</filter-name>
        <url-pattern>/FilteredServlet</url-pattern>
    </filter-mapping>
    
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Restricted area</web-resource-name>
            <url-pattern>/login-success.jsp</url-pattern>
            <http-method>GET</http-method>
            <http-method>POST</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>manager</role-name>
        </auth-constraint>
    </security-constraint>
    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>User Basic Authentication</realm-name>
    </login-config>
<!--    <login-config>-->
<!--        <auth-method>FORM</auth-method>-->
<!--        <form-login-config>-->
<!--            <form-login-page>/login-secure.html</form-login-page>-->
<!--            <form-error-page>/unauthorized.html</form-error-page>-->
<!--        </form-login-config>-->
<!--    </login-config>-->

</web-app>